{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://lamba.tv/devs/kit/lamba.schema.json",
 "title": "lamba.json, version 1",
 "description": "What a Lamba TV app is, what it shows, who takes part, what it may use, and its settings (https://lamba.tv/devs/docs/manifest/). Made from Lamba's own rules (tools/sdk_rules.mjs). lamba-check.mjs also checks what a schema can't: players.min is at most players.max; a choice setting's default is one of its choices, and each choice id is used once; a number setting has min below max, its default between them, and one label per step; a text setting's default is no longer than its max; a photo setting's aspect is between 1:4 and 4:1; a colours setting's default holds min to max colours; a list setting's min is at most its max, and its default and presets hold only ids from of, as many as min to max; a part's photos name photo settings (type photo), each used once; resets name other settings; a part's setting is one of settings.fields; every setting is in a group unless hidden; group keys are used once, and a group's part keys once; an app part (parts[].app) needs screens.phone; a group with players true needs guests true, holds settings only (no app part, no strokes or transforms); action keys are used once and are not group keys; a group's action names one of actions, once; the files lamba.json names are in the folder (icon, card, clips, pictures), and id is the folder's name; an app is bought once (price) or subscribed to (subscription), not both; subscription.yearly costs less than 12 months of monthly; a paid app has a preview, and preview is only for a paid one; outside never names a payment service; a product's id is used once and is not \"app\"; on upload: real clips (not the starter's placeholders), no stagingOnly, listed: false or legacy, an id no one else has.",
 "x-checker-only": [
  "players.min is at most players.max",
  "a choice setting's default is one of its choices, and each choice id is used once",
  "a number setting has min below max, its default between them, and one label per step",
  "a text setting's default is no longer than its max",
  "a photo setting's aspect is between 1:4 and 4:1",
  "a colours setting's default holds min to max colours",
  "a list setting's min is at most its max, and its default and presets hold only ids from of, as many as min to max",
  "a part's photos name photo settings (type photo), each used once",
  "resets name other settings; a part's setting is one of settings.fields; every setting is in a group unless hidden",
  "group keys are used once, and a group's part keys once",
  "an app part (parts[].app) needs screens.phone",
  "a group with players true needs guests true, holds settings only (no app part, no strokes or transforms)",
  "action keys are used once and are not group keys; a group's action names one of actions, once",
  "the files lamba.json names are in the folder (icon, card, clips, pictures), and id is the folder's name",
  "an app is bought once (price) or subscribed to (subscription), not both; subscription.yearly costs less than 12 months of monthly; a paid app has a preview, and preview is only for a paid one; outside never names a payment service",
  "a product's id is used once and is not \"app\"",
  "on upload: real clips (not the starter's placeholders), no stagingOnly, listed: false or legacy, an id no one else has"
 ],
 "type": "object",
 "required": [
  "lamba",
  "id",
  "name",
  "sub",
  "about",
  "icon",
  "screens",
  "guests",
  "age",
  "permissions",
  "outside"
 ],
 "properties": {
  "$schema": {
   "description": "This schema's address, for editors (lamba-check.mjs ignores it)"
  },
  "lamba": {
   "const": 1,
   "description": "The version of these rules"
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9-]{1,23}$",
   "description": "2 to 24 small letters, digits or dashes, starting with a letter; the folder's name"
  },
  "name": {
   "type": "string",
   "maxLength": 24,
   "pattern": "^(?![\\s\\S]*[\\u2013\\u2014])(?![\\s\\S]*\\b[rR][aA][iI][nN][bB][oO][wW]\\b)[\\s\\S]*\\S[\\s\\S]*$",
   "description": "Words people read: at most 24 characters, no en or em dash"
  },
  "sub": {
   "type": "string",
   "maxLength": 40,
   "pattern": "^(?![\\s\\S]*[\\u2013\\u2014])(?![\\s\\S]*\\b[rR][aA][iI][nN][bB][oO][wW]\\b)[\\s\\S]*\\S[\\s\\S]*$",
   "description": "Words people read: at most 40 characters, no en or em dash"
  },
  "about": {
   "type": "string",
   "maxLength": 80,
   "pattern": "^(?![\\s\\S]*[\\u2013\\u2014])(?![\\s\\S]*\\b[rR][aA][iI][nN][bB][oO][wW]\\b)[\\s\\S]*\\S[\\s\\S]*$",
   "description": "Words people read: at most 80 characters, no en or em dash"
  },
  "whatsNew": {
   "type": "string",
   "maxLength": 300,
   "pattern": "^(?![\\s\\S]*[\\u2013\\u2014])(?![\\s\\S]*\\b[rR][aA][iI][nN][bB][oO][wW]\\b)[\\s\\S]*\\S[\\s\\S]*$",
   "description": "For an update: what is new in this version, in plain words (300 letters at most, no HTML). Players read it on the app's page as New, and the reviewer reads it"
  },
  "icon": {
   "type": "string",
   "allOf": [
    {
     "pattern": "^(?![A-Za-z]+:)(?!/)(?![\\s\\S]*\\\\)(?!(?:[\\s\\S]*/)?\\.\\.(?:/|$))[\\s\\S]{1,119}$"
    },
    {
     "pattern": "\\.([sS][vV][gG])$"
    }
   ],
   "description": "A square SVG in the folder"
  },
  "card": {
   "type": "string",
   "allOf": [
    {
     "pattern": "^(?![A-Za-z]+:)(?!/)(?![\\s\\S]*\\\\)(?!(?:[\\s\\S]*/)?\\.\\.(?:/|$))[\\s\\S]{1,119}$"
    }
   ],
   "description": "A 320 x 180 SVG: the app's picture on the start page"
  },
  "tint": {
   "anyOf": [
    {
     "type": "string",
     "pattern": "^#[0-9a-fA-F]{6}$",
     "description": "A colour, #rrggbb"
    },
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "A colour, #rrggbb"
     }
    }
   ]
  },
  "clips": {
   "type": "array",
   "minItems": 2,
   "description": "At least 2 [file, caption]: clips/<file>.mp4 (540 x 920 H.264, 6 to 14 s) and clips/<file>-poster.webp",
   "items": {
    "type": "array",
    "minItems": 2,
    "maxItems": 2,
    "prefixItems": [
     {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,60}$"
     },
     {
      "type": "string",
      "maxLength": 60,
      "pattern": "^(?![\\s\\S]*[\\u2013\\u2014])(?![\\s\\S]*\\b[rR][aA][iI][nN][bB][oO][wW]\\b)[\\s\\S]*\\S[\\s\\S]*$",
      "description": "Words people read: at most 60 characters, no en or em dash"
     }
    ]
   }
  },
  "page": {
   "properties": {
    "facts": {
     "type": "array",
     "maxItems": 6,
     "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
       "type": "string",
       "maxLength": 60,
       "pattern": "^(?![\\s\\S]*[\\u2013\\u2014])(?![\\s\\S]*\\b[rR][aA][iI][nN][bB][oO][wW]\\b)[\\s\\S]*\\S[\\s\\S]*$",
       "description": "Words people read: at most 60 characters, no en or em dash"
      }
     }
    },
    "about": {
     "type": "array",
     "maxItems": 8,
     "items": {
      "type": "object",
      "required": [
       "h"
      ],
      "anyOf": [
       {
        "required": [
         "p"
        ]
       },
       {
        "required": [
         "items"
        ]
       }
      ],
      "properties": {
       "h": {
        "type": "string",
        "maxLength": 60,
        "pattern": "^(?![\\s\\S]*[\\u2013\\u2014])(?![\\s\\S]*\\b[rR][aA][iI][nN][bB][oO][wW]\\b)[\\s\\S]*\\S[\\s\\S]*$",
        "description": "Words people read: at most 60 characters, no en or em dash"
       },
       "p": {
        "type": "string",
        "maxLength": 600,
        "pattern": "^(?![\\s\\S]*[\\u2013\\u2014])(?![\\s\\S]*\\b[rR][aA][iI][nN][bB][oO][wW]\\b)[\\s\\S]*\\S[\\s\\S]*$",
        "description": "Words people read: at most 600 characters, no en or em dash"
       },
       "items": {
        "type": "array",
        "items": {
         "type": "array",
         "minItems": 2,
         "maxItems": 2,
         "prefixItems": [
          {
           "type": "string",
           "maxLength": 40,
           "pattern": "^(?![\\s\\S]*[\\u2013\\u2014])(?![\\s\\S]*\\b[rR][aA][iI][nN][bB][oO][wW]\\b)[\\s\\S]*\\S[\\s\\S]*$",
           "description": "Words people read: at most 40 characters, no en or em dash"
          },
          {
           "type": "string",
           "maxLength": 300,
           "pattern": "^(?![\\s\\S]*[\\u2013\\u2014])(?![\\s\\S]*\\b[rR][aA][iI][nN][bB][oO][wW]\\b)[\\s\\S]*\\S[\\s\\S]*$",
           "description": "Words people read: at most 300 characters, no en or em dash"
          }
         ]
        }
       }
      }
     }
    }
   }
  },
  "screens": {
   "type": "object",
   "required": [
    "tv"
   ],
   "additionalProperties": false,
   "properties": {
    "tv": {
     "type": "string",
     "allOf": [
      {
       "pattern": "^(?![A-Za-z]+:)(?!/)(?![\\s\\S]*\\\\)(?!(?:[\\s\\S]*/)?\\.\\.(?:/|$))[\\s\\S]{1,119}$"
      },
      {
       "pattern": "\\.([hH][tT][mM][lL])$"
      }
     ],
     "description": "The big screen's page"
    },
    "phone": {
     "type": "string",
     "allOf": [
      {
       "pattern": "^(?![A-Za-z]+:)(?!/)(?![\\s\\S]*\\\\)(?!(?:[\\s\\S]*/)?\\.\\.(?:/|$))[\\s\\S]{1,119}$"
      },
      {
       "pattern": "\\.([hH][tT][mM][lL])$"
      }
     ],
     "description": "The phone page"
    },
    "picture": {
     "type": "string",
     "allOf": [
      {
       "pattern": "^(?![A-Za-z]+:)(?!/)(?![\\s\\S]*\\\\)(?!(?:[\\s\\S]*/)?\\.\\.(?:/|$))[\\s\\S]{1,119}$"
      },
      {
       "pattern": "\\.([hH][tT][mM][lL])$"
      }
     ],
     "description": "A lighter page for the small pictures"
    }
   }
  },
  "players": {
   "type": "object",
   "required": [
    "min",
    "max"
   ],
   "properties": {
    "min": {
     "type": "integer",
     "minimum": 0,
     "maximum": 50
    },
    "max": {
     "type": "integer",
     "minimum": 0,
     "maximum": 50
    }
   },
   "description": "Players playing at once (0 to 50), min at most max"
  },
  "guests": {
   "type": "boolean"
  },
  "askName": {
   "type": "boolean",
   "description": "true: a Player is asked their first name once (Lamba keeps it for every app) before the remote, and the app reads it (Lamba.me(), the players' names). Left out or false: a Player goes straight to the remote and the app sees \"Player 1\", \"Player 2\". Ask only if the app shows names (a multiplayer game, scores, turns). Needs guests true"
  },
  "music": {
   "type": "boolean",
   "description": "true: the Host's phone gets Lamba's Music tile (a style and track, or Off, and a volume) and the screen plays it under the app's own sound, with no app code. Players get it too when forPlayers has \"music\""
  },
  "forPlayers": {
   "type": "array",
   "minItems": 1,
   "maxItems": 6,
   "uniqueItems": true,
   "items": {
    "enum": [
     "sound",
     "brightness",
     "frame",
     "effects",
     "schedule",
     "music"
    ]
   },
   "description": "Lamba's own controls Players may be offered on their phones: sound, brightness, frame, effects, schedule, music. The Host switches each one on or off. effects: cracks, lines, colour, signal and flies (never a scare, never in a kids app, they wait for Send). schedule: Players only see when the Screen turns on and off, they never change it. Needs guests true"
  },
  "visitors": {
   "type": "object",
   "required": [
    "max"
   ],
   "additionalProperties": false,
   "properties": {
    "max": {
     "type": "integer",
     "minimum": 1,
     "maximum": 200
    },
    "perMinute": {
     "type": "integer",
     "minimum": 1,
     "maximum": 60
    }
   },
   "description": "More people than players.max, who join with Lamba's join, get the app's player page and send at most perMinute messages a minute each (20 when left out); no seat, never a line. Needs guests true"
  },
  "age": {
   "enum": [
    "all",
    "7+",
    "13+"
   ]
  },
  "category": {
   "enum": [
    "games",
    "party",
    "kids",
    "learning",
    "art",
    "music",
    "clocks",
    "calm",
    "photos",
    "sports",
    "tools"
   ],
   "description": "Where players find it: one of games, party, kids, learning, art, music, clocks, calm, photos, sports, tools"
  },
  "categories": {
   "type": "array",
   "minItems": 1,
   "maxItems": 3,
   "uniqueItems": true,
   "items": {
    "enum": [
     "games",
     "kids",
     "friends",
     "ambient",
     "create",
     "clocks",
     "art",
     "music",
     "tools"
    ]
   },
   "description": "The tabs of the phone's app list it sits in: 1 to 3 of games, kids, friends, ambient, create, clocks, art, music, tools. Left out, they come from category and guests"
  },
  "permissions": {
   "type": "array",
   "items": {
    "enum": [
     "sound",
     "camera",
     "motion",
     "country",
     "microphone",
     "video",
     "ink"
    ]
   },
   "description": "What the app may ask for: sound, camera, motion, country, microphone, video, ink. \"camera\": the picture never leaves the phone (Lamba.track). \"video\": Lamba shows a live camera or screen picture on the screen (Lamba.video.live), only after a tap on Lamba's own button. \"ink\": Lamba draws phone pointers and pen strokes over the screen (Lamba.ink.live), with its own pad on the phones"
  },
  "outside": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^https://[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}(:\\d+)?$"
   },
   "description": "https://host addresses the app may reach (each approved by Lamba)"
  },
  "stagingOnly": {
   "type": "boolean"
  },
  "notInDemo": {
   "type": "boolean"
  },
  "listed": {
   "type": "boolean"
  },
  "liveCard": {
   "type": "boolean"
  },
  "workspace": {
   "type": "boolean",
   "description": "true: part of Workspace on a company's screens (Lamba's own apps only). Outside a company it runs as always"
  },
  "business": {
   "type": "boolean",
   "description": "true: a work app for Lamba TV for Business. It shows and runs only on a company's screens with an active plan or trial; anywhere else it shows a lock that says For Lamba TV for Business"
  },
  "split": {
   "enum": [
    "tall",
    "letterbox"
   ],
   "description": "Split screen (two apps, one in each half): \"letterbox\" (the default) shows the whole 16:9 screen page scaled into the half; \"tall\" gives the page the half's own shape (half the width, the whole height) and Lamba.layout says so"
  },
  "frame": {
   "enum": [
    "none",
    "lamba"
   ],
   "description": "Left out or \"none\": the app starts without a frame or mat (the Host can still pick one). \"lamba\": it starts in Lamba's slim frame on a warm mat"
  },
  "position": {
   "type": "object",
   "required": [
    "after"
   ],
   "properties": {
    "after": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9-]{1,23}$"
    }
   }
  },
  "remote": {
   "type": "object",
   "required": [
    "ok"
   ],
   "properties": {
    "ok": {
     "type": "boolean"
    }
   }
  },
  "actions": {
   "type": "array",
   "minItems": 1,
   "maxItems": 4,
   "description": "One tap tiles in the Host's drawer, first in the row unless a group { \"action\": key } places them. A tap sends { type: \"action\", key } to the screen page (Lamba.on(\"action\", fn))",
   "items": {
    "type": "object",
    "required": [
     "key",
     "label",
     "icon"
    ],
    "additionalProperties": false,
    "properties": {
     "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,23}$",
      "not": {
       "enum": [
        "frame",
        "mat",
        "bright",
        "guest",
        "scribble",
        "effects",
        "schedule",
        "line",
        "visitors",
        "playerctl"
       ]
      }
     },
     "label": {
      "type": "string",
      "maxLength": 24,
      "pattern": "^(?![\\s\\S]*[\\u2013\\u2014])(?![\\s\\S]*\\b[rR][aA][iI][nN][bB][oO][wW]\\b)[\\s\\S]*\\S[\\s\\S]*$",
      "description": "Words people read: at most 24 characters, no en or em dash"
     },
     "icon": {
      "type": "string",
      "allOf": [
       {
        "pattern": "^(?![A-Za-z]+:)(?!/)(?![\\s\\S]*\\\\)(?!(?:[\\s\\S]*/)?\\.\\.(?:/|$))[\\s\\S]{1,119}$"
       },
       {
        "pattern": "\\.([sS][vV][gG])$"
       }
      ],
      "description": "A one colour SVG: the host tints it like every tile's icon"
     }
    }
   }
  },
  "inside": {
   "anyOf": [
    {
     "type": "string",
     "allOf": [
      {
       "pattern": "^(?![A-Za-z]+:)(?!/)(?![\\s\\S]*\\\\)(?!(?:[\\s\\S]*/)?\\.\\.(?:/|$))[\\s\\S]{1,119}$"
      }
     ],
     "description": "A file inside the app's folder, by a relative address"
    },
    {
     "type": "object",
     "required": [
      "by",
      "pictures"
     ],
     "properties": {
      "by": {
       "not": {
        "enum": [
         false,
         0,
         "",
         null
        ]
       }
      },
      "pictures": {
       "type": [
        "object",
        "array"
       ],
       "additionalProperties": {
        "type": "string",
        "allOf": [
         {
          "pattern": "^(?![A-Za-z]+:)(?!/)(?![\\s\\S]*\\\\)(?!(?:[\\s\\S]*/)?\\.\\.(?:/|$))[\\s\\S]{1,119}$"
         }
        ],
        "description": "A file inside the app's folder, by a relative address"
       },
       "items": {
        "type": "string",
        "allOf": [
         {
          "pattern": "^(?![A-Za-z]+:)(?!/)(?![\\s\\S]*\\\\)(?!(?:[\\s\\S]*/)?\\.\\.(?:/|$))[\\s\\S]{1,119}$"
         }
        ],
        "description": "A file inside the app's folder, by a relative address"
       }
      }
     }
    }
   ]
  },
  "legacy": {
   "type": [
    "object",
    "array"
   ],
   "properties": {
    "tvStorage": {
     "type": "string",
     "pattern": "^lf-[a-z0-9-]{1,30}$"
    },
    "store": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]{0,23}$"
     }
    },
    "tvStorageExtra": {
     "type": [
      "object",
      "array"
     ]
    }
   }
  },
  "price": {
   "enum": [
    99,
    199,
    299,
    399,
    499,
    699,
    999,
    1499,
    1999,
    2999,
    4999
   ],
   "description": "Buy the app once: a Lamba price tier in US cents (299 is $2.99). Lamba sells it on the Host's phone with its own payment sheet (docs MONETIZE.md)"
  },
  "subscription": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "monthly": {
     "enum": [
      99,
      199,
      299,
      399,
      499,
      699,
      999,
      1499
     ]
    },
    "yearly": {
     "enum": [
      999,
      1499,
      1999,
      2999,
      3999,
      4999,
      6999,
      9999
     ]
    },
    "trialDays": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "anyOf": [
    {
     "required": [
      "monthly"
     ]
    },
    {
     "required": [
      "yearly"
     ]
    }
   ],
   "description": "Subscribe monthly, yearly or both (Lamba price tiers in US cents), with an optional free trial. The Host can cancel any time"
  },
  "products": {
   "type": "array",
   "maxItems": 20,
   "description": "In-app unlocks, each bought once by the Host and kept for good (Lamba.buy(id) on the Host's phone)",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "price",
     "description"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
     },
     "name": {
      "type": "string",
      "maxLength": 30,
      "pattern": "^(?![\\s\\S]*[\\u2013\\u2014])(?![\\s\\S]*\\b[rR][aA][iI][nN][bB][oO][wW]\\b)[\\s\\S]*\\S[\\s\\S]*$",
      "description": "Words people read: at most 30 characters, no en or em dash"
     },
     "price": {
      "enum": [
       99,
       199,
       299,
       399,
       499,
       699,
       999,
       1499,
       1999
      ]
     },
     "description": {
      "type": "string",
      "maxLength": 90,
      "pattern": "^(?![\\s\\S]*[\\u2013\\u2014])(?![\\s\\S]*\\b[rR][aA][iI][nN][bB][oO][wW]\\b)[\\s\\S]*\\S[\\s\\S]*$",
      "description": "Words people read: at most 90 characters, no en or em dash"
     },
     "kind": {
      "const": "unlock"
     },
     "trialDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
     }
    }
   }
  },
  "preview": {
   "type": "object",
   "required": [
    "mode"
   ],
   "additionalProperties": false,
   "properties": {
    "mode": {
     "enum": [
      "free",
      "time",
      "locked"
     ]
    },
    "minutes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 60
    }
   },
   "if": {
    "properties": {
     "mode": {
      "const": "time"
     }
    }
   },
   "then": {
